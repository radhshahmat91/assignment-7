# ──────────────────────────────────────────────────────────────
#  বাজার দর (BazarDor) — environment variables
#  Copy this file to `.env.local` and fill in the values.
# ──────────────────────────────────────────────────────────────

# Better Auth ---------------------------------------------------
# Any long random string:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Must be an absolute URL with protocol. Local: http://localhost:3000
# Production: https://your-project.vercel.app (never use localhost on Vercel).
BETTER_AUTH_URL=http://localhost:3000

# Database (MongoDB Atlas free tier works great) -----------------
# Required in production. In local development it is optional: if it is
# empty, accounts are kept in memory and disappear when the server restarts.
MONGODB_URI=
MONGODB_DB_NAME=bazardor

# Social login (optional, but the buttons need them to work) ------
# Google  → https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI:  <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub  → https://github.com/settings/developers  (OAuth Apps)
#   Authorization callback URL:  <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Price API (optional) -------------------------------------------
# Comma-separated list of base URLs, tried in order.
# Defaults to the two public Bazar Dor endpoints from the assignment.
# API_BASE_URL=https://api.api-store.workers.dev/api/bazardor,https://api.abcz.workers.dev/api/bazardor
